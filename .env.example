# Copy to .env and fill. NEVER commit .env (gitignored).

# ---- JobBOSS2 (live tenant) ---------------------------------------------
JobBoss2__ApiBaseUrl=https://api-jb2.integrations.ecimanufacturing.com
JobBoss2__AuthBaseUrl=https://api-user.integrations.ecimanufacturing.com
JobBoss2__ClientId=
JobBoss2__ClientSecret=

# ---- MES (Phase 1+) ------------------------------------------------------
DATABASE_URL=postgresql://mes:mes@localhost:5432/mes
MES_SECRET_KEY=
ARTIFACT_DIR=/var/lib/mes/artifacts

# Days of history to backfill on a resource's first-ever sync (G1-D1: an
# unbounded first pull mirrored 16,938 historical orders on a live tenant).
SYNC_BACKFILL_DAYS=30

# Two-person publish gate for the instruction library (DD §7.2). false =
# single-approver (plan §9 default); true = approver must differ from the
# draft's author.
LIBRARY_REQUIRE_APPROVER=false
